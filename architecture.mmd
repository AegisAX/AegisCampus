    Admin(["👨‍💻 시스템 관리자 / 운영자"]):::actor
    Target(["🎯 피싱 모의훈련 대상자"]):::actor

    subgraph Admin_UI ["🖥️ Admin Web Interface<br/>(관리자 화면)"]
        UI_Camp["📊 대시보드 & 캠페인 관리<br/>- 기본 모의훈련 생성 및 통계 확인"]:::base
        UI_Target["👥 그룹 및 사용자 관리<br/>✨ 개선: 대상자 부서(Department) 정보 매핑 추가"]:::improved
        UI_Video["🎬 동영상 교육 관리<br/>🚀 신규: 영상 업로드, 중복 방지, 썸네일 추출"]:::added
        UI_Page["📄 랜딩 및 리다이렉트 관리<br/>🚀 신규: 리다이렉트 페이지 및 랜딩페이지 동영상(Video ID) 매핑"]:::added
    end

    subgraph Backend_Core ["⚙️ Gophish Core & API Engine"]
        API_Main["🔌 기본 Core REST API<br/>- 캠페인, 유저, 템플릿 처리<br/>✨ 개선: 템플릿 변수 치환 및<br/>이벤트 라벨 정규화"]:::improved
        API_Video["📼 신규 Video REST API<br/>🚀 신규: 동영상 스트리밍 및<br/>수강 진도율 처리"]:::added
        API_Redirect["🔀 신규 Redirect REST API<br/>🚀 신규: 리다이렉트 페이지 처리"]:::added
        
        subgraph Tracking_Server ["🌐 Phishing & Training Tracking Server"]
            Track_Base["🔗 기본 추적 기능<br/>- 메일 오픈 및 링크 클릭 추적"]:::base
            Track_Env["💻 접속 환경 추적 고도화<br/>✨ 개선: 브라우저, OS 정보 수집"]:::improved
            Track_Attach["📎 첨부파일 실행 추적<br/>🚀 신규: 파일 실행 이벤트 기록"]:::added
            Track_Train["🎓 수강 진도율 추적<br/>🚀 신규: 영상 시청 시간 기록 및 완료 시 Trained 통계 반영"]:::added
        end
        
        subgraph Background_Workers ["📫 Background Workers & Mail Integration"]
            Worker_SMTP["📤 SMTP 발송 스케줄러<br/>- 설정 시간에 피싱 메일 대량 발송"]:::base
            IMAP_Monitor["🛡️ IMAP 해킹 메일 신고 연동<br/>✨ 개선: 신고자 메모, 헤더, MessageID 파싱 및 로깅"]:::improved
        end
    end

    subgraph Storage ["🗄️ Database & File System"]
        DB_Base[("🗃️ 기본 Gophish 테이블<br/>- users, campaigns, results, events")]:::storage
        DB_Ext[("🗂️ 확장 DB 스키마<br/>✨ 개선: report_note, department, redirect_pages, page.video_id 추가")]:::improved
        DB_Video[("🎞️ 신규 동영상 테이블<br/>🚀 신규: Video, VideoProgress 데이터 저장")]:::added
        FS_Video["📁 로컬 파일 시스템<br/>🚀 신규: 동영상 및 썸네일 저장"]:::added
    end

    subgraph Legend ["💡 다이어그램 색상 범례"]
